# BrickForge reads no .env file. API keys are entered in Settings and stored
# encrypted with Windows' own credential protection (Electron safeStorage).
#
# These optional environment variables are for development and testing.
# Set them in your shell before `npm run dev`.

# Open the app with the bundled sample collection (same as `npm run demo`)
# BRICKFORGE_DEMO=1

# Keep a separate profile (database, settings, scans) in another folder
# BRICKFORGE_USER_DATA=C:\path\to\a\scratch\profile

# Open DevTools in a detached window when running `npm run dev`
# BF_DEVTOOLS=1

# Fallback Rebrickable key, used only when none is saved in Settings
# REBRICKABLE_API_KEY=

# Point a service at a local stand-in (the test suite uses these)
# BRICKFORGE_REBRICKABLE_URL=http://127.0.0.1:4010
# BRICKFORGE_BRICKLINK_URL=http://127.0.0.1:4011
# BRICKFORGE_BRICKOGNIZE_URL=http://127.0.0.1:4012
# BRICKFORGE_ANTHROPIC_URL=http://127.0.0.1:4013
# BRICKFORGE_OPENAI_URL=http://127.0.0.1:4014

# Run a different Claude Code binary for the "Claude Code" AI provider
# BRICKFORGE_CLAUDE_BIN=claude
